{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++ toolchain probe",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-debug/tests/toolchain/hibiki_debug_probe.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Windows Debug"
    },
    {
      "name": "Python project debugpy attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {"host": "127.0.0.1", "port": 5678},
      "justMyCode": true
    }
  ]
}
