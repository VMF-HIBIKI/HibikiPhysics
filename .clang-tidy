Checks: '-*,clang-analyzer-*,bugprone-assert-side-effect,bugprone-dangling-handle,bugprone-sizeof-expression,bugprone-use-after-move,performance-for-range-copy,performance-unnecessary-copy-initialization,modernize-use-nullptr,modernize-use-override,misc-definitions-in-headers,bugprone-unused-raii'
WarningsAsErrors: '*'
HeaderFilterRegex: '.*[/\\](include|src)[/\\].*'
ExcludeHeaderFilterRegex: '(^|[/\\])(build|install|third_party)[/\\]'
