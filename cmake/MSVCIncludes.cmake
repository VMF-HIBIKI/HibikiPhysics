if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
	return()
endif()
get_property(prefix GLOBAL PROPERTY HIBIKI_MSVC_INCLUDE_PREFIX)
if(NOT prefix)
	set(probe "${CMAKE_BINARY_DIR}/CMakeFiles/hibiki-include-probe.cpp")
	file(WRITE "${probe}" "#include <HibikiPhysics/BuildInfo.h>\n")
	get_filename_component(headers "${CMAKE_CURRENT_LIST_DIR}/../include" ABSOLUTE)
	execute_process(COMMAND "${CMAKE_CXX_COMPILER}" /nologo /TP /Zs /showIncludes "/I${headers}" "${probe}"
		ENCODING UTF-8 OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "MSVC include-prefix probe failed: ${errors}")
	endif()
	string(REGEX MATCH "(^|[\r\n])([^\r\n]+:)[ \t]+[A-Za-z]:[/\\]" match "${output}")
	set(prefix "${CMAKE_MATCH_2}")
	if(NOT prefix)
		message(FATAL_ERROR "MSVC include-prefix evidence required: ${output}")
	endif()
	set_property(GLOBAL PROPERTY HIBIKI_MSVC_INCLUDE_PREFIX "${prefix}")
endif()
set(CMAKE_CL_SHOWINCLUDES_PREFIX "${prefix}")
set(CMAKE_C_CL_SHOWINCLUDES_PREFIX "${prefix}")
set(CMAKE_CXX_CL_SHOWINCLUDES_PREFIX "${prefix}")
