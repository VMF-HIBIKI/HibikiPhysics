include_guard(GLOBAL)

# Source identities are read from tools/toolchain-lock.json.
# The caller supplies the directory containing verified source archives.
function(hibiki_declare_dependencies archive_directory)
	include(FetchContent)
	file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/toolchain-lock.json" lock)
	string(JSON count LENGTH "${lock}" artifacts)
	math(EXPR last "${count} - 1")
	foreach(index RANGE 0 ${last})
		string(JSON kind GET "${lock}" artifacts ${index} kind)
		if(kind STREQUAL "cpp_source")
			string(JSON name GET "${lock}" artifacts ${index} id)
			string(JSON filename GET "${lock}" artifacts ${index} filename)
			string(JSON sha256 GET "${lock}" artifacts ${index} sha256)
			string(JSON verification GET "${lock}" artifacts ${index} verification)
			if(NOT verification MATCHES "^(downloaded_and_hashed|publisher_hash_matched)$")
				message(FATAL_ERROR "Source verification required: ${name}")
			endif()
			set(archive "${archive_directory}/${filename}")
			if(NOT EXISTS "${archive}")
				message(FATAL_ERROR "Source archive required: ${archive}")
			endif()
			FetchContent_Declare(${name}
				URL "${archive}"
				URL_HASH "SHA256=${sha256}"
				DOWNLOAD_EXTRACT_TIMESTAMP FALSE
				EXCLUDE_FROM_ALL
			)
		endif()
	endforeach()
endfunction()

