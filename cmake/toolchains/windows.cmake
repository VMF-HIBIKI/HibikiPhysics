if(NOT CMAKE_HOST_WIN32)
	message(FATAL_ERROR "The Windows toolchain requires a Windows host")
endif()
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_PROJECT_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/../MSVCIncludes.cmake")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES HIBIKI_COMPILER HIBIKI_ASAN)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../.local/environment.json" environment)
foreach(key IN ITEMS clang-cl lld-link cmake ninja msvc sdk)
	string(JSON path GET "${environment}" paths "${key}")
	file(TO_CMAKE_PATH "${path}" ${key}_path)
endforeach()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../tools/provenance/windows-system-components.json" system)
string(JSON sdk_version GET "${system}" sdk_directory_version)
if(HIBIKI_COMPILER STREQUAL "msvc")
	set(CMAKE_CXX_COMPILER "${msvc_path}/bin/Hostx64/x64/cl.exe")
	set(CMAKE_LINKER "${msvc_path}/bin/Hostx64/x64/link.exe")
else()
	set(CMAKE_CXX_COMPILER "${clang-cl_path}")
	set(CMAKE_LINKER "${lld-link_path}")
endif()
set(CMAKE_C_COMPILER "${CMAKE_CXX_COMPILER}")
set(CMAKE_MAKE_PROGRAM "${ninja_path}" CACHE FILEPATH "Selected Ninja")
set(CMAKE_RC_COMPILER "${sdk_path}/bin/${sdk_version}/x64/rc.exe")
set(CMAKE_MT "${sdk_path}/bin/${sdk_version}/x64/mt.exe")
set(ENV{INCLUDE} "${msvc_path}/include;${sdk_path}/Include/${sdk_version}/ucrt;${sdk_path}/Include/${sdk_version}/shared;${sdk_path}/Include/${sdk_version}/um;${sdk_path}/Include/${sdk_version}/winrt")
set(ENV{LIB} "${msvc_path}/lib/x64;${sdk_path}/Lib/${sdk_version}/ucrt/x64;${sdk_path}/Lib/${sdk_version}/um/x64")
set(ENV{PATH} "${msvc_path}/bin/Hostx64/x64;${sdk_path}/bin/${sdk_version}/x64;$ENV{PATH}")
set(CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES
	"${msvc_path}/include;${sdk_path}/Include/${sdk_version}/ucrt;${sdk_path}/Include/${sdk_version}/shared;${sdk_path}/Include/${sdk_version}/um;${sdk_path}/Include/${sdk_version}/winrt")
set(CMAKE_C_STANDARD_INCLUDE_DIRECTORIES "${CMAKE_CXX_STANDARD_INCLUDE_DIRECTORIES}")
set(system_link_paths "/LIBPATH:\"${msvc_path}/lib/x64\" /LIBPATH:\"${sdk_path}/Lib/${sdk_version}/ucrt/x64\" /LIBPATH:\"${sdk_path}/Lib/${sdk_version}/um/x64\"")
set(CMAKE_EXE_LINKER_FLAGS "${system_link_paths}" CACHE STRING "Selected system libraries" FORCE)
if(HIBIKI_ASAN)
	set(CMAKE_CXX_FLAGS_DEBUG "/Od /Ob0 /Zi" CACHE STRING "ASan debug flags" FORCE)
	get_filename_component(llvm_bin "${clang-cl_path}" DIRECTORY)
	get_filename_component(llvm_root "${llvm_bin}" DIRECTORY)
	set(asan_runtime "${llvm_root}/lib/clang/22/lib/windows")
	set(ENV{PATH} "${asan_runtime};${llvm_bin};$ENV{PATH}")
	set(CMAKE_EXE_LINKER_FLAGS
		"/LIBPATH:\"${asan_runtime}\" ${system_link_paths} \"${asan_runtime}/clang_rt.asan_dynamic-x86_64.lib\" /wholearchive:\"${asan_runtime}/clang_rt.asan_dynamic_runtime_thunk-x86_64.lib\""
		CACHE STRING "LLVM ASan runtime linkage" FORCE)
endif()
