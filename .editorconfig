root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{h,hpp,cpp,cmake}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[third_party/licenses/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
